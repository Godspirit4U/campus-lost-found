# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is already in .gitignore.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" string if your network does not support IPv6.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase requires TLS. Set to false only for a local Postgres.
DATABASE_SSL=true

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma separated allowed origins for cross-origin callers. Leave empty and the
# API answers same-origin requests only, which is all the bundled frontend needs.
# Set this to the deployed URL if anything else calls the API.
CORS_ORIGIN=

# Passwords for the seeded demo accounts (used only by `npm run seed`).
SEED_ADMIN_EMAIL=sivaharsha.s-29@scds.saiuniversity.edu.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_PASSWORD=Student@12345

# Days before an unclaimed listing is auto-archived.
ARCHIVE_AFTER_DAYS=90

# Set to true to print every SQL statement (noisy; development only).
DB_LOGGING=false

# ---------------------------------------------------------------- image storage
# Leave these empty to keep images on local disk (development only: they are
# lost on redeploy). Fill them in to activate permanent storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ITEM_BUCKET=item-images
SUPABASE_PROOF_BUCKET=claim-proofs

# ------------------------------------------------------------- email (Brevo)
# Leave BREVO_API_KEY empty and reset codes are written to the server log
# instead of being emailed. Set it to send real mail.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@saiuniversity.edu.in
MAIL_FROM_NAME=SaiU Lost & Found
# Set to true to print the full message body in the console adapter.
MAIL_LOG_BODY=false

# --------------------------------------------------------------- password reset
# Key used to hash one-time codes. Defaults to JWT_SECRET when empty, but a
# separate value is better: rotating it invalidates outstanding codes only.
OTP_PEPPER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
